# FaceBench gitignore
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
env/
.env
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
*.log
.idea/
.vscode/
*.swp
experiments/*
!experiments/.gitkeep
experiments/history.jsonl
paper/logs/**
!paper/logs/README.md
paper/weights/**
!paper/weights/README.md
!paper/weights/checksums.sha256
*.onnx
*.dat
*.pth
*.pt
*.ckpt
*.h5
*.pkl
configs/local/
paper/configs/local/
.DS_Store
Thumbs.db
